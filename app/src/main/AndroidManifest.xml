<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone : commandes vocales et, plus tard, écoute des récitations. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Écriture sur la carte mémoire : nécessaire jusqu'à Android 9 inclus
         pour copier les récitations livrées avec l'application. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/screen_home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LessonActivity"
            android:exported="false"
            android:label="@string/screen_lessons"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".MemoryActivity"
            android:exported="false"
            android:label="@string/screen_memory"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ExamActivity"
            android:exported="false"
            android:label="@string/screen_exam"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ProgressActivity"
            android:exported="false"
            android:label="@string/screen_progress"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/screen_settings"
            android:parentActivityName=".MainActivity" />

    </application>
</manifest>
